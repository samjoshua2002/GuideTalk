{
  "expo": {
    "name": "GuideTalk",
    "slug": "guildtalk",
    "version": "1.0.4",
    "orientation": "portrait",
    "scheme": "guidetalk",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#F4CD2A",
          "defaultChannel": "companion-reminders"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.samjoshua2002.guidetalk",
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F4CD2A"
      },
      "package": "com.samjoshua2002.guidetalk",
      "versionCode": 5,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "POST_NOTIFICATIONS",
        "SCHEDULE_EXACT_ALARM",
        "VIBRATE"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "05720c5e-6279-4d8d-b20a-45c2114a9dc8"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/05720c5e-6279-4d8d-b20a-45c2114a9dc8"
    }
  }
}
