{
  "name": "guildtalk",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "tunnel": "expo start --tunnel -c",
    "go": "expo start --go",
    "go:tunnel": "expo start --go --tunnel -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "server": "npm --prefix server start"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/native": "^7.0.14",
    "expo": "^57.0.0",
    "expo-asset": "~57.0.18",
    "expo-audio": "~57.0.5",
    "expo-blur": "~57.0.3",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.19",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-speech": "^57.0.3",
    "expo-speech-recognition": "^57.1.0",
    "expo-status-bar": "~57.0.1",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
